    {
      "path": "scripts/pack/build_win.ps1",
      "pairs": [
        {
          "old": "$LauncherBat = Join-Path $EnvRoot \"QwenPaw Desktop.bat\"",
          "new": "$LauncherBat = Join-Path $EnvRoot \"CoPaw Desktop.bat\""
        },
        {
          "old": "$DebugBat = Join-Path $EnvRoot \"QwenPaw Desktop (Debug).bat\"",
          "new": "$DebugBat = Join-Path $EnvRoot \"CoPaw Desktop (Debug).bat\""
        },
        {
          "old": "echo QwenPaw Desktop - Debug Mode",
          "new": "echo CoPaw Desktop - Debug Mode"
        },
        {
          "old": "echo [Launch] Starting QwenPaw Desktop with log-level=%QWENPAW_LOG_LEVEL%...",
          "new": "echo [Launch] Starting CoPaw Desktop with log-level=%QWENPAW_LOG_LEVEL%..."
        },
        {
          "old": "echo [Exit] QwenPaw Desktop closed",
          "new": "echo [Exit] CoPaw Desktop closed"
        },
        {
          "old": "$LauncherVbs = Join-Path $EnvRoot \"QwenPaw Desktop.vbs\"",
          "new": "$LauncherVbs = Join-Path $EnvRoot \"CoPaw Desktop.vbs\""
        },
        {
          "old": "batPath = CreateObject(\"Scripting.FileSystemObject\").GetParentFolderName(WScript.ScriptFullName) & \"\\QwenPaw Desktop.bat\"",
          "new": "batPath = CreateObject(\"Scripting.FileSystemObject\").GetParentFolderName(WScript.ScriptFullName) & \"\\CoPaw Desktop.bat\""
        }
      ]
    },
    {
      "path": "scripts/pack/desktop.nsi",
      "pairs": [
        {
          "old": "; QwenPaw Desktop NSIS installer. Run makensis from repo root after",
          "new": "; CoPaw Desktop NSIS installer. Run makensis from repo root after"
        },
        {
          "old": "; Usage: makensis /DQWENPAW_VERSION=1.2.3 /DOUTPUT_EXE=dist\\QwenPaw-Setup-1.2.3.exe scripts\\pack\\desktop.nsi",
          "new": "; Usage: makensis /DQWENPAW_VERSION=1.2.3 /DOUTPUT_EXE=dist\\CoPaw-Setup-1.2.3.exe scripts\\pack\\desktop.nsi"
        },
        {
          "old": "  !define OUTPUT_EXE \"dist\\QwenPaw-Setup-${QWENPAW_VERSION}.exe\"",
          "new": "  !define OUTPUT_EXE \"dist\\CoPaw-Setup-${QWENPAW_VERSION}.exe\""
        },
        {
          "old": "Name \"QwenPaw Desktop\"",
          "new": "Name \"CoPaw Desktop\""
        },
        {
          "old": "InstallDir \"$LOCALAPPDATA\\QwenPaw\"",
          "new": "InstallDir \"$LOCALAPPDATA\\CoPaw\""
        },
        {
          "old": "InstallDirRegKey HKCU \"Software\\QwenPaw\" \"InstallPath\"",
          "new": "InstallDirRegKey HKCU \"Software\\CoPaw\" \"InstallPath\""
        },
        {
          "old": "Section \"QwenPaw Desktop\" SEC01",
          "new": "Section \"CoPaw Desktop\" SEC01"
        },
        {
          "old": "  WriteRegStr HKCU \"Software\\QwenPaw\" \"InstallPath\" \"$INSTDIR\"",
          "new": "  WriteRegStr HKCU \"Software\\CoPaw\" \"InstallPath\" \"$INSTDIR\""
        },
        {
          "old": "  CreateShortcut \"$SMPROGRAMS\\QwenPaw Desktop.lnk\" \"$INSTDIR\\QwenPaw Desktop.vbs\" \"\" \"$INSTDIR\\icon.ico\" 0",
          "new": "  CreateShortcut \"$SMPROGRAMS\\CoPaw Desktop.lnk\" \"$INSTDIR\\CoPaw Desktop.vbs\" \"\" \"$INSTDIR\\icon.ico\" 0"
        },
        {
          "old": "  CreateShortcut \"$DESKTOP\\QwenPaw Desktop.lnk\" \"$INSTDIR\\QwenPaw Desktop.vbs\" \"\" \"$INSTDIR\\icon.ico\" 0",
          "new": "  CreateShortcut \"$DESKTOP\\CoPaw Desktop.lnk\" \"$INSTDIR\\CoPaw Desktop.vbs\" \"\" \"$INSTDIR\\icon.ico\" 0"
        },
        {
          "old": "  CreateShortcut \"$SMPROGRAMS\\QwenPaw Desktop (Debug).lnk\" \"$INSTDIR\\QwenPaw Desktop (Debug).bat\" \"\" \"$INSTDIR\\icon.ico\" 0",
          "new": "  CreateShortcut \"$SMPROGRAMS\\CoPaw Desktop (Debug).lnk\" \"$INSTDIR\\CoPaw Desktop (Debug).bat\" \"\" \"$INSTDIR\\icon.ico\" 0"
        },
        {
          "old": "  Delete \"$SMPROGRAMS\\QwenPaw Desktop.lnk\"",
          "new": "  Delete \"$SMPROGRAMS\\CoPaw Desktop.lnk\""
        },
        {
          "old": "  Delete \"$SMPROGRAMS\\QwenPaw Desktop (Debug).lnk\"",
          "new": "  Delete \"$SMPROGRAMS\\CoPaw Desktop (Debug).lnk\""
        },
        {
          "old": "  Delete \"$DESKTOP\\QwenPaw Desktop.lnk\"",
          "new": "  Delete \"$DESKTOP\\CoPaw Desktop.lnk\""
        },
        {
          "old": "  DeleteRegKey HKCU \"Software\\QwenPaw\"",
          "new": "  DeleteRegKey HKCU \"Software\\CoPaw\""
        }
      ]
