      "path": "scripts/pack/build_macos.sh",
      "pairs": [
        {
          "old": "# One-click build: console -> conda-pack -> QwenPaw.app. Run from repo root.",
          "new": "# One-click build: console -> conda-pack -> CoPaw.app. Run from repo root."
        },
        {
          "old": "APP_NAME=\"QwenPaw\"",
          "new": "APP_NAME=\"CoPaw\""
        },
        {
          "old": "  { echo \"=== $(date) QwenPaw starting ===\"",
          "new": "  { echo \"=== $(date) CoPaw starting ===\""
        }
      ]
